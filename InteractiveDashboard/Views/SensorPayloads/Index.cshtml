@model List<InteractiveDashboard.Models.SensorPayload>

@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-container">

    
    <div class="dashboard-header">
        <h1>DASHBOARD</h1>

       
    </div>

    <div class="main-cards">

        <div class="dashboard-card sensors-card">
            <div class="dashboard-card-top">
                <h3>SENSORS</h3>

                <span class="material-icons-outlined">
                    sensors
                </span>
            </div>

            <h2>@ViewBag.TotalSensors</h2>
        </div>

        <div class="dashboard-card categories-card">
            <div class="dashboard-card-top">
                <h3>CATEGORIES</h3>

                <span class="material-icons-outlined">
                    category
                </span>
            </div>

            <h2>@ViewBag.TotalCategories</h2>
        </div>

        <div class="dashboard-card locations-card">
            <div class="dashboard-card-top">
                <h3>LOCATIONS</h3>

                <span class="material-icons-outlined">
                    location_on
                </span>
            </div>

            <h2>@ViewBag.TotalLocations</h2>
        </div>

        <div class="dashboard-card alerts-card">
            <div class="dashboard-card-top">
                <h3>ALERTS</h3>

                <span class="material-icons-outlined">
                    notification_important
                </span>
            </div>

            <h2>0</h2>
        </div>

    </div>

    <div class="dashboard-charts">

        <div class="dashboard-chart-card">

            <h2>Sensor Categories</h2>

            <div id="bar-chart"></div>

        </div>

  

    </div>

    <div class="sensor-table-card">

        <div class="table-header">

            <div>
                <h2>Sensor Payloads</h2>
                <p>Manage your sensor records</p>
            </div>

            <a asp-action="Create" class="add-table-btn">
                <span class="material-icons-outlined">add</span>
                Add Sensor
            </a>

        </div>

        <div class="table-responsive">

            <table class="sensor-table">

                <thead>
                    <tr>
                        <th>Device ID</th>
                        <th>MAC Address</th>
                        <th>Location</th>
                        <th>Category</th>
                        <th>Sensor Value</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <td>@item.DeviceID</td>

                                <td>@item.MAC_Address</td>

                                <td>@item.Deployment_Location</td>

                                <td>
                                    <span class="category-badge">
                                        @item.Category
                                    </span>
                                </td>

                                <td class="sensor-value">
                                    @item.SensorValue
                                </td>

                                <td>

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="action-btn details-btn">
                                        Details
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="action-btn edit-btn">
                                        Edit
                                    </a>

                                    <a asp-action="Upload"
                                       asp-route-id="@item.Id"
                                       class="action-btn upload-btn">
                                        Upload
                                    </a>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="empty-table">
                                No sensors have been added yet.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
    

</div>

@section Scripts {

   
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script src="~/js/scripts.js"></script>
   

}
